# IdleCUA environment — copy to .env and fill in values.
# No secrets are committed; API keys must be set via environment or credential store.

# Data directory (defaults to ~/.idlecua)
# IDLECUA_DATA_DIR=~/.idlecua

# Model provider (OpenAI-compatible) — managed via CLI, not this file.
# Keys are stored only in the macOS Keychain (service `idlecua`).
# Use the CLI so keys never touch files, logs, or the repo:
#
#   idle-cua models add --name openrouter --base-url https://openrouter.ai/api/v1 \
#     --model anthropic/claude-3.5-sonnet --api-key $OPENROUTER_API_KEY
#   idle-cua models add --name opencode-go --base-url https://opencode.ai/zen/go/v1 \
#     --model anthropic/claude-3.5-sonnet --api-key-env OPENCODE_GO_API_KEY
#   idle-cua models add --name my-openai --base-url https://api.openai.com/v1 \
#     --model gpt-4o --api-key $OPENAI_API_KEY
#
# Any other OpenAI-compatible endpoint works the same way.
# List/select/test/remove:
#   idle-cua models list
#   idle-cua models select openrouter
#   idle-cua models test
#   idle-cua models remove my-openai
#
# API keys — never commit; prefer system credential store, fallback to env var
# The CLI stores the key in Keychain; these env vars are only for --api-key-env fallback:
# OPENROUTER_API_KEY=
# OPENCODE_GO_API_KEY=
# OPENAI_API_KEY=

# Limits (optional overrides)
# IDLECUA_MAX_ACTIONS_PER_SESSION=200
# IDLECUA_MAX_DURATION_MINUTES=45
# IDLECUA_MAX_LLM_CALLS_PER_DAY=150

# Schedule
# IDLECUA_IDLE_THRESHOLD_SECONDS=600
